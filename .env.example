# Docker image version
VERSION=latest

# Admin panel login (username is always "admin")
ADMIN_PASSWORD=change-me

# Session cookie encryption (generate with: openssl rand -hex 16)
SESSION_SECRET=generate-a-random-32-character-string-here

# CSRF token key (generate with: openssl rand -hex 16)
CSRF_SECRET=generate-another-random-32-character-string
