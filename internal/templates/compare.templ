package templates

import "fmt"

templ ComparePage(data CompareData, active string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>village-pulse — Component Comparison</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
		</head>
		<body class="min-h-screen bg-base-200">
			<div class="flex h-screen">
				<div class="w-64 bg-base-100 border-r border-base-300 p-4 flex flex-col flex-shrink-0">
					<h2 class="text-lg font-bold mb-4">Components</h2>
					for _, c := range data.Components {
						<a href={ fmt.Sprintf("/compare/%s", c.Slug) }
						   class={ "px-3 py-2 rounded-lg text-sm mb-1 block", activeClass(c.Slug == active) }>
							{ c.Icon } { c.Name }
						</a>
					}
					<div class="mt-auto pt-4 border-t border-base-300">
						<a href="/" class="text-xs text-base-content/50 hover:text-primary">← Dashboard</a>
					</div>
				</div>
				<div class="flex-1 flex flex-col min-w-0">
					<div class="bg-base-100 px-4 py-2 border-b border-base-300 text-sm font-medium flex-shrink-0">
						{ componentName(data.Components, active) } — Side by Side Comparison
					</div>
					<div class="flex-1 flex gap-0 overflow-hidden">
						<div class="flex-1 border-r border-base-300 overflow-auto p-4 min-w-0">
							<div class="text-xs text-base-content/40 uppercase mb-2">village-pulse (Templ)</div>
							<div class="max-w-[450px]">
								if data.Weather != nil {
									@WeatherWidget(*data.Weather)
								}
								if data.Events != nil {
									@EventsWidget(*data.Events)
								}
								if data.Alerts != nil {
									@AlertsWidget(*data.Alerts)
								}
								if data.Energy != nil {
									@EnergyWidget(*data.Energy)
								}
							</div>
						</div>
						<div class="flex-1 overflow-auto p-4 bg-base-200/50 min-w-0">
							<div class="text-xs text-base-content/40 uppercase mb-2">Reference</div>
							<div class="max-w-[450px]">
								if data.RefImage != "" {
									<img src={ data.RefImage } class="w-full rounded shadow-lg" alt="Reference"/>
								} else {
									<div class="text-base-content/30 italic text-sm">No reference image yet</div>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</body>
	</html>
}

func activeClass(active bool) string {
	if active { return "bg-primary/10 text-primary font-medium" }
	return "text-base-content/70 hover:bg-base-200"
}

func componentName(items []CompareItem, slug string) string {
	for _, c := range items {
		if c.Slug == slug { return c.Name }
	}
	return slug
}

type CompareData struct {
	Components []CompareItem
	Weather    *WeatherData
	Events     *EventsData
	Alerts     *AlertsData
	Energy     *EnergyData
	RefImage   string
}

type CompareItem struct {
	Name string
	Slug string
	Icon string
}
