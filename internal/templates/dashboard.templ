package templates

import (
	"fmt"
	ui "github.com/emergent-company/go-daisy/components/ui"
)

templ DashboardPage(data DashboardData) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.VillageName } — Community Dashboard</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@next/dist/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-base-200">
			<div class="max-w-6xl mx-auto px-4 py-6">
				<div class="flex justify-between items-center mb-4">
					<div>
						<h1 class="text-3xl font-bold text-base-content">{ data.VillageName }</h1>
						if data.Description != "" {
							<p class="text-base-content/60">{ data.Description }</p>
						}
					</div>
					@ui.ThemeSwitcher()
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
					@WeatherWidget(data.Weather)
					@EventsWidget(data.Events)
					@AlertsWidget(data.Alerts)
					@EnergyWidget(data.Energy)
				</div>
				<div class="text-center mt-8 pb-4 text-xs text-base-content/40">
					Powered by village-pulse
				</div>
			</div>
		</body>
	</html>
}

// ── Weather ─────────────────────────────────────────────────────────────────

templ WeatherWidget(w WeatherData) {
	@ui.Card("☀️ Weather", nil) {
		<div class="flex items-center w-full min-w-0">
			<div class="flex-shrink-0 mr-4" style="width:64px;height:64px;">
				<div class="text-6xl leading-none flex items-center justify-center h-full">{ weatherIcon(w.Condition) }</div>
			</div>
			<div class="flex flex-col flex-1 min-w-0 overflow-hidden">
				<div class="text-lg text-base-content/70 truncate">{ w.ConditionText }</div>
			</div>
			<div class="flex flex-col items-end flex-shrink-0 ml-2">
				<div class="text-3xl font-bold leading-tight whitespace-nowrap">{ fmt.Sprintf("%.1f", w.Temperature) }{ w.TemperatureUnit }</div>
				<div class="flex items-center gap-1 text-sm text-base-content/50">
					<span>🌡</span>
					<span>{ fmt.Sprintf("Feels %.0f° · %.0f %s %s", w.FeelsLike, w.WindSpeed, w.WindSpeedUnit, w.WindDirection) }</span>
				</div>
			</div>
		</div>
		@ui.Divider(ui.DividerNeutral, false)
		<div class="grid grid-cols-2 gap-x-5 gap-y-1 text-sm">
			<div class="flex items-center gap-2"><span>💧</span><span class="font-mono">{ fmt.Sprintf("%.0f%%", w.Humidity) }</span></div>
			<div class="flex items-center gap-2 flex-row-reverse"><span>🌬</span><span class="font-mono">{ fmt.Sprintf("%.0f %s %s", w.WindSpeed, w.WindSpeedUnit, w.WindDirection) }</span></div>
			<div class="flex items-center gap-2"><span>📊</span><span class="font-mono">{ fmt.Sprintf("%.0f %s", w.Pressure, w.PressureUnit) }</span></div>
			<div class="flex items-center gap-2 flex-row-reverse"><span>☀️</span><span class="font-mono">UV 5</span></div>
		</div>
		@ui.Divider(ui.DividerNeutral, false)
		<div class="flex items-center gap-3 mb-1">
			<a href="#" class="text-xs font-semibold text-primary uppercase border-b-2 border-primary pb-0.5">Daily</a>
			<a href="#" class="text-xs font-semibold text-base-content/40 uppercase hover:text-base-content/60">Hourly</a>
		</div>
		<div class="w-full overflow-x-auto scrollbar-none cursor-grab select-none overscroll-x-contain" style="scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch;">
			<div class="flex flex-row justify-start gap-0">
				for _, d := range w.Forecast {
					<div class="flex flex-col items-center text-center py-0.5 px-0.5 flex-shrink-0" style="min-width:70px; max-width:70px; scroll-snap-align:start;">
						<div class="text-[11px] font-semibold text-base-content/50 uppercase tracking-wider h-5 leading-5">{ d.Day }</div>
						<div class="py-0.5" style="width:36px;height:36px;">
							<div class="text-2xl">{ weatherIcon(d.Condition) }</div>
						</div>
						<div class="flex items-center justify-center whitespace-nowrap text-sm gap-0.5 min-h-5">
							<span class="font-semibold">{ fmt.Sprintf("%.0f°", d.High) }</span>
							<span class="text-base-content/40">{ fmt.Sprintf("%.0f°", d.Low) }</span>
						</div>
						<div class="relative flex items-end justify-center mt-1" style="height:18px;width:30px;">
							<div class="absolute bottom-0 rounded-sm overflow-hidden flex flex-col justify-end" style={ fmt.Sprintf("height:%d%%;width:30px;background:rgba(33,150,243,0.4)", precipBarPct(d.PrecipProb)) }></div>
							<div class="relative z-10 text-[11px] font-medium text-info leading-4">{ fmt.Sprintf("%d%%", d.PrecipProb) }</div>
						</div>
						if d.PrecipAmount > 0 {
							<div class="text-[10px] text-base-content/40 font-mono">{ fmt.Sprintf("%.1f mm", d.PrecipAmount) }</div>
						}
						if d.WindDir != "" {
							<div class="text-[10px] text-base-content/30 mt-0.5">{ d.WindDir }</div>
						}
					</div>
				}
			</div>
		</div>
	}
}

func precipBarPct(prob int) int {
	if prob > 100 { return 100 }
	return prob
}

func precipColor(prob int) string {
	switch {
	case prob > 70:  return "#3b82f6"
	case prob > 30:  return "#60a5fa"
	default:         return "#93c5fd"
	}
}

func weatherIcon(condition string) string {
	switch condition {
	case "sunny":        return "☀️"
	case "partlycloudy": return "⛅"
	case "cloudy":       return "☁️"
	case "rainy":        return "🌧"
	case "pouring":      return "🌧"
	case "snowy":        return "🌨"
	case "fog":          return "🌫"
	case "lightning":    return "⛈"
	case "clear-night":  return "🌙"
	case "windy":        return "💨"
	default:             return "☀️"
	}
}

// ── Events ──────────────────────────────────────────────────────────────────

templ EventsWidget(e EventsData) {
	@ui.Card("📅 Events", nil) {
		<span class="badge badge-sm">{ fmt.Sprintf("%d", e.TotalCount) }</span>
		if len(e.Today) > 0 {
			<div class="text-xs font-semibold text-base-content/50 uppercase mb-1 mt-2">Today</div>
			for _, ev := range e.Today {
				@EventRow(ev)
			}
		}
		if len(e.ThisWeek) > 0 {
			<div class="text-xs font-semibold text-base-content/50 uppercase mt-2 mb-1">This Week</div>
			for _, ev := range e.ThisWeek {
				@EventRow(ev)
			}
		}
		if len(e.Today) == 0 && len(e.ThisWeek) == 0 {
			<div class="text-sm text-base-content/40 italic">No upcoming events</div>
		}
	}
}

templ EventRow(ev EventItem) {
	<div class="flex items-start gap-2 py-1.5">
		<div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" style={ fmt.Sprintf("background-color:%s", ev.Color) }></div>
		<div class="min-w-0">
			<div class="text-sm font-medium">{ ev.Title }</div>
			<div class="text-xs text-base-content/50">{ ev.Time }</div>
			if ev.Location != "" {
				<div class="text-xs text-base-content/40">{ ev.Location }</div>
			}
		</div>
	</div>
}

// ── Alerts ──────────────────────────────────────────────────────────────────

templ AlertsWidget(a AlertsData) {
	@ui.Card("⚠️ Alerts", nil) {
		if len(a.Items) == 0 {
			<div class="alert alert-success">
				<span>✅ No active alerts</span>
			</div>
		} else {
			for _, al := range a.Items {
				@AlertBanner(al)
			}
		}
	}
}

templ AlertBanner(a AlertItem) {
	<div class={ "alert mb-2", alertClass(a.Severity) }>
		<div class="flex gap-2">
			<span>{ severityIcon(a.Severity) }</span>
			<div class="flex-1">
				<div class="font-bold text-sm">
					if a.Pinned {
						<span class="badge badge-xs mr-1">PINNED</span>
					}
					{ a.Title }
				</div>
				<div class="text-xs">{ a.Message }</div>
				<div class="text-xs opacity-60 mt-0.5">{ a.Expiry }</div>
			</div>
		</div>
	</div>
}

func alertClass(s string) string {
	switch s {
	case "critical": return "alert-error"
	case "severe":   return "alert-warning"
	case "warning":  return "alert-warning"
	default:         return "alert-info"
	}
}

func severityIcon(s string) string {
	switch s {
	case "critical": return "🔴"
	case "severe":   return "🟠"
	case "warning":  return "🟡"
	default:         return "🔵"
	}
}

// ── Energy ──────────────────────────────────────────────────────────────────

templ EnergyWidget(e EnergyData) {
	@ui.Card("⚡ Energy", nil) {
		for _, ent := range e.Entities {
			@EnergyRow(ent)
		}
		<div class="divider my-2"></div>
		@Sparkline(e.Sparkline)
		<div class="text-xs text-base-content/40 mt-1">Updated { e.UpdatedAt }</div>
	}
}

templ EnergyRow(e EnergyEntity) {
	<div class="flex items-center justify-between py-1">
		<div class="flex items-center gap-2">
			<span>{ energyIcon(e.Icon) }</span>
			<span class="text-sm">{ e.Name }</span>
		</div>
		<div class="flex items-center gap-2">
			<span class="font-bold">{ e.Value } { e.Unit }</span>
			if e.Trend == "up" {
				<span class="badge badge-success badge-xs">↑ { e.TrendLabel }</span>
			} else if e.Trend == "down" {
				<span class="badge badge-error badge-xs">↓ { e.TrendLabel }</span>
			} else {
				<span class="badge badge-ghost badge-xs">→ { e.TrendLabel }</span>
			}
		</div>
	</div>
}

templ Sparkline(data []int) {
	<div class="flex items-end gap-1 h-8">
		for _, v := range data {
			<div class="w-6 bg-primary/20 rounded-sm" style={ fmt.Sprintf("height:%d%%; min-height:4px", v*100/25) }></div>
		}
	</div>
}

func energyIcon(icon string) string {
	switch icon {
	case "sun":     return "☀️"
	case "zap":     return "⚡"
	case "plug":    return "🔌"
	case "battery": return "🔋"
	case "flame":   return "🔥"
	case "droplet": return "💧"
	default:        return "📊"
	}
}
