package templates

import "fmt"

templ DashboardPage(data DashboardData) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.VillageName } — Community Dashboard</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@next/dist/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-base-200">
			<div class="max-w-6xl mx-auto px-4 py-6">
				@Header(data.VillageName, data.Description)
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
					@WeatherCard(data.Weather)
					@EventsCard(data.Events)
					@AlertsCard(data.Alerts)
					@EnergyCard(data.Energy)
				</div>
				@Footer()
			</div>
		</body>
	</html>
}

templ Header(name, description string) {
	<div class="text-center mb-2">
		<h1 class="text-3xl font-bold text-base-content">{ name }</h1>
		if description != "" {
			<p class="text-base-content/60">{ description }</p>
		}
	</div>
}

templ Footer() {
	<div class="text-center mt-8 pb-4 text-xs text-base-content/40">
		Powered by village-pulse
	</div>
}

// ── Weather ─────────────────────────────────────────────────────────────────

templ WeatherCard(w WeatherData) {
	<div class="card bg-base-100 shadow-sm">
		<div class="card-body p-5">
			<h2 class="card-title text-lg mb-3">
				<span>☀️ Weather</span>
			</h2>
			@CurrentConditions(w)
			<div class="divider my-2"></div>
			@ForecastRow(w.Forecast)
		</div>
	</div>
}

templ CurrentConditions(w WeatherData) {
	<div class="flex items-center gap-4">
		<div class="text-6xl">@WeatherIcon(w.Condition)</div>
		<div>
			<div class="text-4xl font-bold">{ fmt.Sprintf("%.1f", w.Temperature) }{ w.TemperatureUnit }</div>
			<div class="text-base-content/70">{ w.ConditionText }</div>
			<div class="text-sm text-base-content/50">
				Feels like { fmt.Sprintf("%.1f", w.FeelsLike) }{ w.TemperatureUnit } · Wind { fmt.Sprintf("%.1f", w.WindSpeed) } { w.WindSpeedUnit } { w.WindDirection }
			</div>
		</div>
	</div>
}

templ ForecastRow(days []ForecastDay) {
	<div class="flex overflow-x-auto gap-2 mt-1 -mx-1 px-1">
		for _, d := range days {
			<div class="flex flex-col items-center min-w-[60px] text-center">
				<div class="text-xs font-medium text-base-content/60">{ d.Day }</div>
				<div class="text-2xl my-1">@WeatherIcon(d.Condition)</div>
				<div class="text-sm font-bold">{ fmt.Sprintf("%.0f", d.High) }°</div>
				<div class="text-xs text-base-content/50">{ fmt.Sprintf("%.0f", d.Low) }°</div>
				<div class="text-xs text-info/70 mt-0.5">{ d.PrecipProb }%</div>
			</div>
		}
	</div>
}

templ WeatherIcon(condition string) {
	switch condition {
	case "sunny":
		<span>☀️</span>
	case "partlycloudy":
		<span>⛅</span>
	case "cloudy":
		<span>☁️</span>
	case "rainy":
		<span>🌧</span>
	case "pouring":
		<span>🌧</span>
	case "snowy":
		<span>🌨</span>
	case "fog":
		<span>🌫</span>
	case "lightning":
		<span>⛈</span>
	case "clear-night":
		<span>🌙</span>
	case "windy":
		<span>💨</span>
	default:
		<span>☀️</span>
	}
}

// ── Events ──────────────────────────────────────────────────────────────────

templ EventsCard(e EventsData) {
	<div class="card bg-base-100 shadow-sm">
		<div class="card-body p-5">
			<h2 class="card-title text-lg mb-3">
				<span>📅 Events</span>
				<span class="badge badge-sm">{ fmt.Sprintf("%d", e.TotalCount) }</span>
			</h2>
			if len(e.Today) > 0 {
				<div class="text-xs font-semibold text-base-content/50 uppercase mb-1">Today</div>
				for _, ev := range e.Today {
					@EventRow(ev)
				}
			}
			if len(e.ThisWeek) > 0 {
				<div class="text-xs font-semibold text-base-content/50 uppercase mt-2 mb-1">This Week</div>
				for _, ev := range e.ThisWeek {
					@EventRow(ev)
				}
			}
			if len(e.Today) == 0 && len(e.ThisWeek) == 0 {
				<div class="text-sm text-base-content/40 italic">No upcoming events</div>
			}
		</div>
	</div>
}

templ EventRow(ev EventItem) {
	<div class="flex items-start gap-2 py-1.5">
		<div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" style={ fmt.Sprintf("background-color:%s", ev.Color) }></div>
		<div class="min-w-0">
			<div class="text-sm font-medium">{ ev.Title }</div>
			<div class="text-xs text-base-content/50">{ ev.Time }</div>
			if ev.Location != "" {
				<div class="text-xs text-base-content/40">{ ev.Location }</div>
			}
		</div>
	</div>
}

// ── Alerts ──────────────────────────────────────────────────────────────────

templ AlertsCard(a AlertsData) {
	<div class="card bg-base-100 shadow-sm">
		<div class="card-body p-5">
			<h2 class="card-title text-lg mb-3">
				<span>⚠️ Alerts</span>
			</h2>
			if len(a.Items) == 0 {
				<div class="alert alert-success">
					<span>✅ No active alerts</span>
				</div>
			} else {
				for _, al := range a.Items {
					@AlertBanner(al)
				}
			}
		</div>
	</div>
}

templ AlertBanner(a AlertItem) {
	<div class={ "alert mb-2", alertClass(a.Severity) }>
		<div class="flex gap-2">
			<span>{ severityIcon(a.Severity) }</span>
			<div class="flex-1">
				<div class="font-bold text-sm">
					if a.Pinned {
						<span class="badge badge-xs mr-1">PINNED</span>
					}
					{ a.Title }
				</div>
				<div class="text-xs">{ a.Message }</div>
				<div class="text-xs opacity-60 mt-0.5">{ a.Expiry }</div>
			</div>
		</div>
	</div>
}

func alertClass(s string) string {
	switch s {
	case "critical": return "alert-error"
	case "severe":   return "alert-warning"
	case "warning":  return "alert-warning"
	default:         return "alert-info"
	}
}

func severityIcon(s string) string {
	switch s {
	case "critical": return "🔴"
	case "severe":   return "🟠"
	case "warning":  return "🟡"
	default:         return "🔵"
	}
}

// ── Energy ──────────────────────────────────────────────────────────────────

templ EnergyCard(e EnergyData) {
	<div class="card bg-base-100 shadow-sm">
		<div class="card-body p-5">
			<h2 class="card-title text-lg mb-3">
				<span>⚡ Energy</span>
			</h2>
			for _, ent := range e.Entities {
				@EnergyRow(ent)
			}
			<div class="divider my-2"></div>
			@Sparkline(e.Sparkline)
			<div class="text-xs text-base-content/40 mt-1">Updated { e.UpdatedAt }</div>
		</div>
	</div>
}

templ EnergyRow(e EnergyEntity) {
	<div class="flex items-center justify-between py-1">
		<div class="flex items-center gap-2">
			<span>{ energyIcon(e.Icon) }</span>
			<span class="text-sm">{ e.Name }</span>
		</div>
		<div class="flex items-center gap-2">
			<span class="font-bold">{ e.Value } { e.Unit }</span>
			if e.Trend == "up" {
				<span class="badge badge-success badge-xs">↑ { e.TrendLabel }</span>
			} else if e.Trend == "down" {
				<span class="badge badge-error badge-xs">↓ { e.TrendLabel }</span>
			} else {
				<span class="badge badge-ghost badge-xs">→ { e.TrendLabel }</span>
			}
		</div>
	</div>
}

templ Sparkline(data []int) {
	<div class="flex items-end gap-1 h-8">
		for _, v := range data {
			<div class="w-6 bg-primary/20 rounded-sm" style={ fmt.Sprintf("height:%d%%; min-height:4px", v*100/25) }></div>
		}
	</div>
}

func energyIcon(icon string) string {
	switch icon {
	case "sun":    return "☀️"
	case "zap":    return "⚡"
	case "plug":   return "🔌"
	case "battery": return "🔋"
	case "flame":  return "🔥"
	case "droplet": return "💧"
	default:       return "📊"
	}
}
